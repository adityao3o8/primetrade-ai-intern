NODE_ENV=development
PORT=3000

# Required by runtime checks
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/primetrade?schema=public
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Optional tuning
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# CORS whitelist for the React frontend
# Comma-separated origins
CORS_ORIGINS=http://localhost:5173

# Optional: when a user registers with this email, they will be created as admin.
# Keep this secret/unknown in real deployments.
ADMIN_EMAIL=

# Cookies for JWT storage (HttpOnly)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# 7 days default
COOKIE_MAX_AGE_MS=604800000

